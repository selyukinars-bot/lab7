// Массив задач
let tasks = [
    { id: 1, text: "Изучить JavaScript", completed: false },
    { id: 2, text: "Выполнить лабораторную работу", completed: true },
    { id: 3, text: "Повторить тему DOM", completed: false }
];

// Получение элементов страницы
const input = document.querySelector("#taskInput");
const addBtn = document.querySelector("#addBtn");
const taskList = document.querySelector("#taskList");
const taskCount = document.querySelector("#taskCount");
const filterButtons = document.querySelectorAll("[data-filter]");

let currentFilter = "all";

// Отображение задач
function renderTasks() {
    taskList.replaceChildren();

    let filteredTasks = tasks.filter(task => {
        if (currentFilter === "active") {
            return !task.completed;
        }

        if (currentFilter === "completed") {
            return task.completed;
        }

        return true;
    });

    if (filteredTasks.length === 0) {
        const message = document.createElement("li");
        message.textContent = "Задач пока нет";
        message.classList.add("empty");
        taskList.append(message);
    }

    filteredTasks.forEach(task => {
        const item = document.createElement("li");

        item.textContent = task.text;

        if (task.completed) {
            item.classList.add("completed");
        }

        // Изменение статуса задачи
        item.addEventListener("click", () => {
            task.completed = !task.completed;
            renderTasks();
        });

        taskList.append(item);
    });

    // Общее количество задач
    taskCount.textContent = tasks.length;
}

// Добавление задачи
function addTask() {
    const text = input.value.trim();

    if (text === "") {
        alert("Введите название задачи!");
        return;
    }

    tasks.push({
        id: Date.now(),
        text: text,
        completed: false
    });

    input.value = "";
    renderTasks();
}

// Обработка кнопки добавления
addBtn.addEventListener("click", addTask);

// Добавление задачи клавишей Enter
input.addEventListener("keydown", event => {
    if (event.key === "Enter") {
        addTask();
    }
});

// Переключение вкладок
filterButtons.forEach(button => {
    button.addEventListener("click", () => {
        currentFilter = button.dataset.filter;

        filterButtons.forEach(btn => {
            btn.classList.toggle("active", btn === button);
        });

        renderTasks();
    });
});

// Первоначальное отображение
renderTasks();
