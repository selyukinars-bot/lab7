// Данные разделов сайта
const pages = {
    about: {
        title: "О себе",
        text: "Меня зовут Арсений. Я студент группы ИС-25-21. Изучаю программирование, информационные системы и современные технологии."
    },

    skills: {
        title: "Мои навыки",
        text: "Я изучаю следующие технологии:"
        ,
        skills: [
            "HTML — создание веб-страниц",
            "CSS — оформление сайтов",
            "JavaScript — программирование",
            "Python — основы программирования",
            "MySQL — работа с базами данных"
        ]
    },

    contacts: {
        title: "Контакты",
        text: "Связаться со мной можно следующими способами:",
        contacts: [
            "Имя: Арсений",
            "Группа: ИС-25-21",
            "Специальность: Информационные системы"
        ]
    }
};

// Получение элементов страницы
const content = document.querySelector("#content");
const buttons = document.querySelectorAll("[data-page]");

// Функция отображения раздела
function showPage(pageName) {
    const page = pages[pageName];

    if (!page) {
        content.textContent = "Ошибка: раздел не найден.";
        return;
    }

    // Очистка старого содержимого
    content.replaceChildren();

    // Создание заголовка
    const title = document.createElement("h2");
    title.textContent = page.title;
    content.append(title);

    // Создание текста
    const paragraph = document.createElement("p");
    paragraph.textContent = page.text;
    content.append(paragraph);

    // Создание списка навыков или контактов
    const items = page.skills || page.contacts;

    if (items) {
        const list = document.createElement("ul");

        items.forEach(item => {
            const li = document.createElement("li");
            li.textContent = item;
            list.append(li);
        });

        content.append(list);
    }

    // Выделение активной вкладки
    buttons.forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.page === pageName
        );
    });
}

// Обработка нажатий на вкладки
buttons.forEach(button => {
    button.addEventListener("click", () => {
        showPage(button.dataset.page);
    });
});

// Открытие первой вкладки
showPage("about");
