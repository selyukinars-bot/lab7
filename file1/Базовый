* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #e9eef5;
    margin: 0;
    padding: 40px 15px;
}

.container {
    max-width: 700px;
    margin: auto;
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px #00000015;
}

header {
    background: #263b63;
    color: white;
    text-align: center;
    padding: 35px;
}

header h1 {
    margin: 0 0 10px;
}

nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 20px;
    background: #f5f5f5;
}

nav button {
    padding: 12px 20px;
    border: none;
    border-radius: 7px;
    background: #dce3ed;
    cursor: pointer;
    font-size: 15px;
}

nav button:hover,
nav button.active {
    background: #263b63;
    color: white;
}

main {
    min-height: 230px;
    padding: 30px;
    line-height: 1.7;
}

main h2 {
    color: #263b63;
}

main li {
    margin: 8px 0;
}

footer {
    text-align: center;
    padding: 15px;
    background: #f5f5f5;
    color: #777;
}

@media (max-width: 480px) {
    nav {
        flex-wrap: wrap;
    }

    nav button {
        flex: 1;
    }
}



