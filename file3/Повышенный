* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #e9eef5;
    margin: 0;
    padding: 30px 15px;
}

.container {
    max-width: 900px;
    margin: auto;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px #00000015;
}

header {
    background: #263b63;
    color: white;
    text-align: center;
    padding: 25px;
}

.statistics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding: 20px;
}

.stat-card {
    background: #f0f3f8;
    padding: 15px;
    text-align: center;
    border-radius: 8px;
}

.stat-card span {
    color: #666;
    font-size: 14px;
}

.stat-card h2 {
    color: #263b63;
    margin: 10px 0 0;
}

nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 15px;
    background: #f3f5f8;
}

nav button {
    padding: 12px 20px;
    border: none;
    border-radius: 7px;
    background: #dce3ed;
    cursor: pointer;
}

nav button.active {
    background: #263b63;
    color: white;
}

nav span {
    font-weight: bold;
}

main {
    padding: 20px;
    min-height: 250px;
}

.order {
    background: #f5f7fa;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 18px;
    margin-bottom: 15px;
}

.order h3 {
    margin-top: 0;
    color: #263b63;
}

.order p {
    margin: 8px 0;
}

.actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.actions button {
    padding: 9px 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    color: white;
}

.next {
    background: #2878d0;
}

.back {
    background: #777;
}

.empty {
    text-align: center;
    color: gray;
    padding: 30px;
}

footer {
    text-align: center;
    padding: 15px;
    background: #f3f5f8;
    color: #777;
}

@media (max-width: 600px) {
    .statistics {
        grid-template-columns: repeat(2, 1fr);
    }

    nav {
        flex-wrap: wrap;
    }

    nav button {
        flex: 1;
    }
}

