// Массив заказов
let orders = [
    {
        id: 101,
        client: "Александр",
        product: "Игровая клавиатура",
        price: 25000,
        status: "new"
    },
    {
        id: 102,
        client: "Дмитрий",
        product: "Компьютерная мышь",
        price: 12000,
        status: "new"
    },
    {
        id: 103,
        client: "Артём",
        product: "Наушники",
        price: 18000,
        status: "work"
    },
    {
        id: 104,
        client: "Максим",
        product: "Монитор",
        price: 95000,
        status: "done"
    }
];

// Получение элементов страницы
const ordersList = document.querySelector("#ordersList");
const buttons = document.querySelectorAll("[data-status]");

// Текущая вкладка
let currentStatus = "new";

// Названия статусов
const statusNames = {
    new: "Новый",
    work: "В работе",
    done: "Готов"
};

// Форматирование цены
function formatPrice(price) {
    return price.toLocaleString("ru-RU") + " ₸";
}

// Обновление счетчиков
function updateCounters() {
    const newOrders = orders.filter(o => o.status === "new").length;
    const workOrders = orders.filter(o => o.status === "work").length;
    const doneOrders = orders.filter(o => o.status === "done").length;

    document.querySelector("#totalCount").textContent = orders.length;

    document.querySelector("#newCount").textContent = newOrders;
    document.querySelector("#workCount").textContent = workOrders;
    document.querySelector("#doneCount").textContent = doneOrders;

    document.querySelector("#tabNew").textContent = newOrders;
    document.querySelector("#tabWork").textContent = workOrders;
    document.querySelector("#tabDone").textContent = doneOrders;
}

// Отображение заказов
function renderOrders() {
    ordersList.replaceChildren();

    // Выбираем заказы текущей вкладки
    const filteredOrders = orders.filter(order => {
        return order.status === currentStatus;
    });

    if (filteredOrders.length === 0) {
        const message = document.createElement("p");
        message.textContent = "В этой категории пока нет заказов.";
        message.classList.add("empty");
        ordersList.append(message);
    }

    filteredOrders.forEach(order => {
        const card = document.createElement("div");
        card.classList.add("order");

        const title = document.createElement("h3");
        title.textContent = "Заказ №" + order.id;

        const client = document.createElement("p");
        client.textContent = "Клиент: " + order.client;

        const product = document.createElement("p");
        product.textContent = "Товар: " + order.product;

        const price = document.createElement("p");
        price.textContent = "Стоимость: " + formatPrice(order.price);

        const status = document.createElement("p");
        status.textContent = "Статус: " + statusNames[order.status];

        card.append(title, client, product, price, status);

        const actions = document.createElement("div");
        actions.classList.add("actions");

        // Кнопка изменения статуса
        if (order.status !== "done") {
            const nextBtn = document.createElement("button");
            nextBtn.textContent = order.status === "new"
                ? "Начать работу"
                : "Завершить заказ";

            nextBtn.classList.add("next");

            nextBtn.addEventListener("click", () => {
                changeStatus(order.id, "next");
            });

            actions.append(nextBtn);
        }

        // Кнопка возврата заказа
        if (order.status !== "new") {
            const backBtn = document.createElement("button");
            backBtn.textContent = "Вернуть назад";
            backBtn.classList.add("back");

            backBtn.addEventListener("click", () => {
                changeStatus(order.id, "back");
            });

            actions.append(backBtn);
        }

        card.append(actions);
        ordersList.append(card);
    });

    updateCounters();
}

// Изменение статуса заказа
function changeStatus(id, direction) {
    const order = orders.find(item => item.id === id);

    if (!order) return;

    if (direction === "next") {
        if (order.status === "new") {
            order.status = "work";
        } else if (order.status === "work") {
            order.status = "done";
        }
    }

    if (direction === "back") {
        if (order.status === "done") {
            order.status = "work";
        } else if (order.status === "work") {
            order.status = "new";
        }
    }

    // Обновляем панель
    renderOrders();
}

// Переключение вкладок
buttons.forEach(button => {
    button.addEventListener("click", () => {
        currentStatus = button.dataset.status;

        buttons.forEach(btn => {
            btn.classList.toggle("active", btn === button);
        });

        renderOrders();
    });
});

// Первоначальный запуск
renderOrders();

